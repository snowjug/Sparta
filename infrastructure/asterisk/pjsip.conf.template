; Sparta local-SIP: PJSIP configuration TEMPLATE. entrypoint.sh renders it to /etc/asterisk/pjsip.conf, replacing every
; @@NAME@@ placeholder. Nothing secret is stored in this file: the SIP passwords come from the environment (or *_FILE
; mounts) and are generated by `python scripts/sip_local.py init`.
;
; What is deliberately NOT here: an anonymous endpoint, a trunk, a registration to any provider, an identify-by-IP match, a
; wildcard outbound route. A SIP client must authenticate as 6001 or 6002 to do anything at all, and the only thing it can
; dial is 6000 (extensions.conf).

[global]
type = global
user_agent = Sparta-Asterisk
; Identify callers by the user name in the SIP request only (never by source address, never anonymously).
endpoint_identifier_order = username
; Requests that match no endpoint raise security events (they are logged by res_security_log). This is NOT a ban: add a
; host firewall or fail2ban if the SIP port is ever exposed beyond a trusted network (see the README).
unidentified_request_count = 5
unidentified_request_period = 5
unidentified_request_prune_interval = 30

[system]
type = system
timer_t1 = 500
timer_b = 32000
disable_tcp_switch = yes

; Only private networks may send this PBX anything before authentication. This is a network filter, not the credential.
[acl]
type = acl
deny = 0.0.0.0/0
@@ACL_PERMIT_LINES@@

[transport-udp]
type = transport
protocol = udp
bind = 0.0.0.0:5060
@@NAT_LINES@@

; ---------------------------------------------------------------------------------------------------------------------
; Settings shared by both phones.
[sparta-phone](!)
type = endpoint
context = from-sparta-sip
disallow = all
; G.711 only: 8 kHz, what the media bridge uses, and what every SIP client supports.
allow = ulaw
allow = alaw
identify_by = username
; Behind Docker's NAT the far end's RTP must come back to the address it came from.
direct_media = no
rtp_symmetric = yes
force_rport = yes
rewrite_contact = yes
dtmf_mode = rfc4733
media_encryption = no
ice_support = no
allow_overlap = no
allow_transfer = no
allow_unauthenticated_options = no
trust_id_inbound = no
trust_id_outbound = no
send_pai = no
send_rpid = no
; A call whose far end stops sending RTP is ended instead of hanging for ever.
rtp_timeout = 60
rtp_timeout_hold = 120
max_audio_streams = 1
max_video_streams = 0
language = en

; 6001: the test caller (a Linphone phone, or scripts/sip_e2e.py's baresip).
[6001](sparta-phone)
auth = auth6001
aors = 6001
callerid = "Sparta test caller" <6001>

[auth6001]
type = auth
auth_type = userpass
username = 6001
password = @@SIP_PASSWORD_6001@@
realm = sparta

[6001]
type = aor
max_contacts = 1
remove_existing = yes
qualify_frequency = 30
default_expiration = 3600
minimum_expiration = 60
maximum_expiration = 7200

; 6002: the owner's phone, rung when the owner takes a call over from the Sparta app.
[6002](sparta-phone)
auth = auth6002
aors = 6002
callerid = "Sparta owner" <6002>

[auth6002]
type = auth
auth_type = userpass
username = 6002
password = @@SIP_PASSWORD_6002@@
realm = sparta

[6002]
type = aor
max_contacts = 1
remove_existing = yes
qualify_frequency = 30
default_expiration = 3600
minimum_expiration = 60
maximum_expiration = 7200
