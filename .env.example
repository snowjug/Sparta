# =====================================================================================================================
# Sparta environment template.
#
#   Bash / zsh:   cp .env.example .env
#   PowerShell:   Copy-Item .env.example .env
#
# * Every value in this file is a DUMMY or a safe development default. A real `.env` is git-ignored: never commit one
#   and never paste real secrets into this template.
# * Who reads `.env`:
#     - scripts/dev.ps1, scripts/dev.sh and `make dev` export it into the API/web processes they start on the host;
#     - `docker compose` uses it for variable substitution (ports, dev passwords, web build arguments) and passes the
#       remaining SPARTA_* values to the api container (docker-compose.yml forces the container-internal database and
#       Redis URLs, so the host-run values below never leak into the container);
#     - the production deployment does NOT use a file at all: see infrastructure/azure and docs/DEPLOYMENT.md.
# * Lines starting with `#` are optional overrides (shown with their defaults or a placeholder).
# * Never leave a variable defined but EMPTY (for example `SPARTA_DATA_KEYS=`): the API treats an empty value as "set"
#   and refuses to start. Comment the line out instead.
# * Only SPARTA_* and NEXT_PUBLIC_* names are read by the application. Reference: services/api/src/sparta/config.py.
# =====================================================================================================================


# ---------------------------------------------------------------------------------------------------------------------
# 1. Runtime
# ---------------------------------------------------------------------------------------------------------------------
# development | test | production. `production` switches on the startup guards in docs/DEPLOYMENT.md (OIDC only, real
# keys, PostgreSQL, Redis, https CORS origins, explicit trusted hosts, no raw audio storage).
SPARTA_ENV=development
SPARTA_LOG_LEVEL=INFO
# true = one JSON object per line (what production and log pipelines want); false = readable lines for local work.
SPARTA_LOG_JSON=false
# SPARTA_SERVICE_NAME=sparta-api
# Directory for the development keys and the default SQLite file (relative paths resolve against services/api).
# SPARTA_DATA_DIR=./var


# ---------------------------------------------------------------------------------------------------------------------
# 2. Authentication
# ---------------------------------------------------------------------------------------------------------------------
# dev  = no sign-in. Anyone who can reach the API acts as the development owner and every client shows a permanent
#        "Development identity" banner. Only for a trusted machine. Forbidden when SPARTA_ENV=production.
# oidc = validate OpenID Connect bearer tokens (Microsoft Entra ID or any compliant issuer).
SPARTA_AUTH_MODE=dev
# `sparta serve` REFUSES to listen on a non-loopback address (for example 0.0.0.0 in a container) while the development
# identity is active, because anyone who could reach the server would act as the owner. Opt in only for a trusted local
# network or container: docker-compose.yml sets it to true for its 127.0.0.1-only published port. Leave it unset for a
# host-run API (scripts/dev.* bind 127.0.0.1) and NEVER set it on a shared, public or production host.
# SPARTA_ALLOW_NETWORK_DEV_AUTH=false
# SPARTA_DEV_USER_ID=dev-owner
# SPARTA_DEV_USER_NAME=Dev Owner
# Only for SPARTA_AUTH_MODE=oidc (placeholders; <tenant-id> is your Entra tenant GUID):
# SPARTA_OIDC_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
# SPARTA_OIDC_AUDIENCE=api://sparta-api
# SPARTA_OIDC_JWKS_URL=https://login.microsoftonline.com/<tenant-id>/discovery/v2.0/keys
# SPARTA_OIDC_ALGORITHMS=RS256


# ---------------------------------------------------------------------------------------------------------------------
# 3. Storage and keys
# ---------------------------------------------------------------------------------------------------------------------
# Database. Default: SQLite under services/api/var (development only; refused in production).
# SPARTA_DATABASE_URL=sqlite+aiosqlite:///./var/sparta.db
# Host-run API against the PostgreSQL that `docker compose up -d postgres` publishes on 127.0.0.1 (the password and
# port come from section 10). scripts/dev.ps1 -Docker and `make dev-deps` build this URL for you.
# SPARTA_DATABASE_URL=postgresql+asyncpg://sparta:sparta-dev-only@127.0.0.1:5432/sparta
#
# Shared state (rate limits, single-use WebSocket tickets, call locks, cross-instance live events). Unset = in-process
# memory, fine for a single instance. Required in production (use rediss:// for TLS).
# SPARTA_REDIS_URL=redis://:sparta-dev-only@127.0.0.1:6379/0
#
# Run Alembic migrations at startup. Ignored (always off) in production: run `python -m sparta migrate` as a release step.
# SPARTA_AUTO_MIGRATE=true
#
# Application-level encryption of call content and personal data (Fernet, SPARTA_DATA_KEYS), caller-number hashing
# (SPARTA_PEPPER) and the HMAC of the generic telephony webhook (SPARTA_WEBHOOK_SECRET).
# In development, leave SPARTA_DATA_KEYS and SPARTA_PEPPER unset: the API creates stable development keys under
# SPARTA_DATA_DIR (dev-data.key and dev-pepper.key; git-ignored). SPARTA_WEBHOOK_SECRET is NOT generated: while it is unset,
# POST /api/v1/webhooks/generic answers "not configured" (set it, with SPARTA_TELEPHONY_PROVIDER=other, to use that webhook).
# In production all three are REQUIRED and must come from a secret store, never from a file in the repository.
# Generate fresh values (prints three lines; nothing is stored):
#     cd services/api && python -m sparta keygen            (inside the venv)
#     make keygen                                           (or scripts/keygen.ps1 on Windows)
#     docker run --rm sparta-api python -m sparta keygen    (from the built image)
# Rotation: put the NEW key first in SPARTA_DATA_KEYS, keep the old ones after it (comma-separated), deploy, then retire
# the old key once nothing encrypted with it remains. Changing SPARTA_PEPPER invalidates every stored caller fingerprint.
# SPARTA_DATA_KEYS=<fernet-key>[,<older-fernet-key>]
# SPARTA_PEPPER=<random-string>
# SPARTA_WEBHOOK_SECRET=<random-string>


# ---------------------------------------------------------------------------------------------------------------------
# 4. HTTP surface
# ---------------------------------------------------------------------------------------------------------------------
# Comma-separated browser origins allowed to call the API (no spaces). Must include the web app's origin.
# Production: https origins only, no localhost.
SPARTA_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# WebSocket origins; defaults to SPARTA_CORS_ORIGINS.
# SPARTA_ALLOWED_WS_ORIGINS=http://localhost:3000
# Host header allow-list. "*" is accepted only outside production; production needs explicit host names.
# SPARTA_TRUSTED_HOSTS=*
# Public base URL of the API as seen by browsers and providers (used to build WebSocket URLs and callbacks).
SPARTA_PUBLIC_BASE_URL=http://localhost:8000
# SPARTA_MAX_REQUEST_BYTES=512000
# SPARTA_MAX_AUDIO_BYTES=8000000
# SPARTA_MAX_AUDIO_SECONDS=120
# Prometheus text at /metrics (counters and timings, no personal data). Restrict the route to a monitoring network.
# SPARTA_EXPOSE_METRICS=false


# ---------------------------------------------------------------------------------------------------------------------
# 5. Providers
# ---------------------------------------------------------------------------------------------------------------------
# The defaults below run the full product on the built-in simulator with deterministic rules: no cloud account, no
# cost, and no real phone call or audio. Switching a provider needs the credentials listed under it, and the API
# refuses to start (listing every missing variable) when they are absent.
SPARTA_TELEPHONY_PROVIDER=simulator
SPARTA_STT_PROVIDER=simulator
SPARTA_TTS_PROVIDER=simulator
SPARTA_LLM_PROVIDER=rules
# Simulator Lab endpoints (/api/v1/simulator/*). Keep on for development; turn off in a production tenant.
SPARTA_SIMULATOR_ENABLED=true

# --- Azure AI Speech (SPARTA_STT_PROVIDER=azure and/or SPARTA_TTS_PROVIDER=azure). Placeholders only. ---
# SPARTA_AZURE_SPEECH_KEY=<speech-resource-key>
# SPARTA_AZURE_SPEECH_REGION=centralindia
# Custom-domain endpoint; defaults to the regional host.
# SPARTA_AZURE_SPEECH_ENDPOINT=https://<custom-domain>.cognitiveservices.azure.com

# --- Azure OpenAI (SPARTA_LLM_PROVIDER=azure_openai). Placeholders only. ---
# SPARTA_AZURE_OPENAI_ENDPOINT=https://<resource-name>.openai.azure.com
# SPARTA_AZURE_OPENAI_KEY=<openai-resource-key>
# SPARTA_AZURE_OPENAI_DEPLOYMENT=<your-deployment-name>
# SPARTA_AZURE_OPENAI_API_VERSION=2024-10-21

# --- Azure Communication Services Call Automation (SPARTA_TELEPHONY_PROVIDER=azure). Placeholders only. ---
# Needs the `azure` extra (the Docker image includes it by default). ACS cannot provision +91 numbers directly and
# nothing here has been exercised against a live ACS resource: read docs/TELEPHONY.md and docs/DEPLOYMENT.md first.
# SPARTA_ACS_CONNECTION_STRING=endpoint=https://<resource-name>.communication.azure.com/;accesskey=<access-key>
# Public https base URL that ACS calls back (usually the same as SPARTA_PUBLIC_BASE_URL in production).
# SPARTA_ACS_CALLBACK_BASE_URL=https://api.example.com
# ACS resource id: the expected audience of Call Automation callback tokens.
# SPARTA_ACS_RESOURCE_ID=<acs-resource-id>
# Event Grid secure webhook (IncomingCall): tenant that issues the delivery tokens and the token audience.
# SPARTA_ENTRA_TENANT_ID=<tenant-guid>
# SPARTA_EVENT_GRID_AUDIENCE=<event-grid-webhook-audience>
# Owner that receives calls delivered by a real provider, and the provider number the owner forwards calls to.
# SPARTA_TELEPHONY_OWNER_USER_ID=<owner-user-id>
# SPARTA_FORWARDING_NUMBER=+10000000000
# SPARTA_TELEPHONY_PLUGIN=package.module:factory        # only with SPARTA_TELEPHONY_PROVIDER=other

# Provider call behaviour and cost estimates (USD). Estimates feed guardrails and dashboards, not billing.
# SPARTA_PROVIDER_TIMEOUT_S=6.0
# SPARTA_PROVIDER_MAX_RETRIES=2
# SPARTA_ESTIMATED_STT_PER_AUDIO_HOUR_USD=0.0
# SPARTA_ESTIMATED_TTS_PER_MILLION_CHARS_USD=0.0
# SPARTA_ESTIMATED_LLM_PER_MILLION_PROMPT_TOKENS_USD=0.0
# SPARTA_ESTIMATED_LLM_PER_MILLION_COMPLETION_TOKENS_USD=0.0
# SPARTA_ESTIMATED_TELEPHONY_PER_MINUTE_USD=0.0


# ---------------------------------------------------------------------------------------------------------------------
# 6. Limits and guardrails
# ---------------------------------------------------------------------------------------------------------------------
# SPARTA_RATE_LIMIT_PER_MINUTE=240
# SPARTA_CALL_CREATE_RATE_LIMIT_PER_MINUTE=20
# SPARTA_PROFILE_WRITE_RATE_LIMIT_PER_MINUTE=12     # assistant-profile saves (a new owner name builds matchers)
# SPARTA_DAILY_CALL_CAP=200
# SPARTA_DAILY_SCREENING_EVENT_CAP=2000             # native Android screening events per owner per UTC day
# SPARTA_MAX_ACTIVE_CALLS=5
# SPARTA_MAX_CALL_DURATION_S=600
# SPARTA_ABANDONED_CALL_TIMEOUT_S=180
# SPARTA_REAPER_INTERVAL_S=15
# SPARTA_RETENTION_JOB_INTERVAL_S=3600
# SPARTA_ESCALATION_RESOLVER_INTERVAL_S=5


# ---------------------------------------------------------------------------------------------------------------------
# 7. Feature flags (expensive or sensitive features are off by default)
# ---------------------------------------------------------------------------------------------------------------------
# Personal Voice needs Microsoft Limited Access approval, explicit consent and a supported locale/region (see docs).
# SPARTA_FEATURE_PERSONAL_VOICE=false
# SPARTA_FEATURE_LLM_SUMMARIES=false
# Raw audio is never stored by default and the API refuses to start with this on in production.
# SPARTA_FEATURE_RAW_AUDIO_STORAGE=false


# ---------------------------------------------------------------------------------------------------------------------
# 8. Observability
# ---------------------------------------------------------------------------------------------------------------------
# Traces carry identifiers and timings only, never transcript text or phone numbers. Spans: one SERVER span per HTTP request
# (named "METHOD /route/template", with the request id and the status), one "provider.call" span per provider call and one
# "engine.on_caller_turn" span per caller turn. A call created inside a request takes that request's trace id
# (CallDetail.trace_id). Only traces are exported: there is no metrics or logs export (Prometheus text: SPARTA_EXPOSE_METRICS).
# SPARTA_OTEL_ENABLED=true
# OTLP/HTTP *traces* endpoint (needs the `otlp` extra, included in the Docker image by default), for example a local
# OpenTelemetry Collector:
# SPARTA_OTLP_ENDPOINT=http://127.0.0.1:4318/v1/traces


# ---------------------------------------------------------------------------------------------------------------------
# 9. Web app (apps/web). Only NEXT_PUBLIC_* values reach the browser: never put secrets here.
# ---------------------------------------------------------------------------------------------------------------------
# These are baked in when the web app is BUILT (next build): after changing them, rebuild (docker compose build web,
# or npm run build). For `npm run dev` / `make dev` they can also live in apps/web/.env.local.
# Base URL of the API as seen from the browser (no trailing slash). Its origin must be in SPARTA_CORS_ORIGINS.
# Defaults to http://localhost:8000 (docker compose derives it from SPARTA_API_PORT).
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Sign-in mode compiled into the web app.
#   dev  = no sign-in: the browser sends no credentials (plus the optional X-Sparta-Dev-User header), which only an API
#          running the development identity accepts; every screen shows a permanent "Development identity" banner.
#   oidc = Authorization Code + PKCE through oidc-client-ts. The code exists in apps/web but it has NEVER been run against a
#          real identity provider or against the API's token validation (see apps/web/README.md and docs/WEB_APP.md).
#          Treat the web app as development-identity only for now: do not count on it to sign in to a production API
#          (SPARTA_AUTH_MODE=oidc) until that has been verified end to end.
NEXT_PUBLIC_AUTH_MODE=dev
# Read only when NEXT_PUBLIC_AUTH_MODE=oidc (unverified, see above); leave them unset otherwise:
# NEXT_PUBLIC_OIDC_AUTHORITY=https://login.microsoftonline.com/<tenant-id>/v2.0
# NEXT_PUBLIC_OIDC_CLIENT_ID=<spa-app-registration-client-id>
# NEXT_PUBLIC_OIDC_SCOPE=openid profile


# ---------------------------------------------------------------------------------------------------------------------
# 10. Docker Compose (docker-compose.yml)
# ---------------------------------------------------------------------------------------------------------------------
# Host ports. Every published port is bound to 127.0.0.1 only. Change them if something else already uses them.
# SPARTA_API_PORT=8000
# SPARTA_WEB_PORT=3000
# SPARTA_POSTGRES_PORT=5432
# SPARTA_REDIS_PORT=6379
# Development-only credentials for the compose PostgreSQL and Redis. They protect nothing beyond your own machine.
# SPARTA_POSTGRES_PASSWORD=sparta-dev-only
# SPARTA_REDIS_PASSWORD=sparta-dev-only
# Extras baked into the API image: azure (ACS SDK), otlp (OTLP exporter). Use `SPARTA_EXTRAS=` for the slimmest image.
# SPARTA_EXTRAS=azure,otlp
# Package index for image builds; set it to a mirror when pypi.org is not reachable from your network.
# PIP_INDEX_URL=https://pypi.org/simple
# npm registry for the web image build (npm rewrites the registry.npmjs.org URLs of package-lock.json to it).
# NPM_REGISTRY=https://registry.npmjs.org/


# ---------------------------------------------------------------------------------------------------------------------
# 11. Tests and tooling (optional)
# ---------------------------------------------------------------------------------------------------------------------
# Enable the PostgreSQL integration tests (skipped when unset). WARNING: they DROP ALL TABLES in that database, so point
# them at a dedicated throwaway database, never at the one your dev API uses:
#     docker compose exec postgres createdb -U sparta sparta_test
# SPARTA_TEST_POSTGRES_URL=postgresql+asyncpg://sparta:sparta-dev-only@127.0.0.1:5432/sparta_test
# Reserved for Redis integration tests: no test reads it yet (RedisKV is exercised by the compose smoke test instead).
# SPARTA_TEST_REDIS_URL=redis://:sparta-dev-only@127.0.0.1:6379/1
# Playwright E2E for apps/web: reuse servers that are already running, or start the API differently.
# E2E_REUSE_SERVERS=1
# SPARTA_API_COMMAND=python -X utf8 -m sparta serve --host 127.0.0.1 --port 8100
