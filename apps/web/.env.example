# Copy to .env.local for local development. Only NEXT_PUBLIC_* values reach the browser: never put secrets here.

# Base URL of the Sparta API (no trailing slash). Must be listed in the API's SPARTA_CORS_ORIGINS for the web origin.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# dev  = no sign-in; the API issues a development identity and the UI shows a permanent "Development identity" banner.
# oidc = Authorization Code + PKCE sign-in with oidc-client-ts. Implemented and unit-tested with a fake UserManager, but NOT verified
#        against a live identity provider or tenant (see README, "Known limitations").
NEXT_PUBLIC_AUTH_MODE=dev

# Read only when NEXT_PUBLIC_AUTH_MODE=oidc (public client, no secret). Register <web origin>/auth/callback as the redirect URI.
# The authority is also added to the Content-Security-Policy connect-src.
# NEXT_PUBLIC_OIDC_AUTHORITY=https://login.example.com/tenant/v2.0
# NEXT_PUBLIC_OIDC_CLIENT_ID=
# NEXT_PUBLIC_OIDC_SCOPE=openid profile
