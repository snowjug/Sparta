<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark-first window; Compose paints the active Sparta theme on top. -->
    <style name="Theme.Sparta" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/sparta_background</item>
        <item name="android:colorAccent">@color/sparta_accent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
