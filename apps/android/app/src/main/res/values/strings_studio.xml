    <string name="studio_title">Assistant Studio</string>
    <string name="studio_subtitle">How Sparta presents itself when it talks to a caller for you.</string>
    <string name="studio_no_backend_title">Connect a backend to use the studio</string>
    <string name="studio_no_backend_body">The assistant\'s voice and wording are produced by your Sparta backend, so there is nothing to configure on this phone alone.</string>

    <string name="studio_disclosure_title">What callers hear first</string>
    <string name="studio_disclosure_example">\u201cHello, I\'m %1$s\'s AI call assistant. May I know who is calling and what this is regarding?\u201d</string>
    <string name="studio_default_owner">the owner</string>
    <string name="studio_disclosure_always_on">The AI disclosure is always on and cannot be turned off. Sparta never pretends to be you.</string>

